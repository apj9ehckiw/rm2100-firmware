#!/bin/sh
# campus-fix v2.7: campus portal auto-login daemon + LuCI page.
#
# Reverse-engineered from a HAR capture of the portal flow
# (广东某职业院校 / 中山校区 Portal, NFV-BASE-1 AC):
#   1) Any HTTP request gets hijacked to http://10.0.0.1/, which returns a
#      JS redirect to http://10.1.110.2/portal.do?<params>. We skip the
#      hijack dance and query the status endpoint directly.
#   2) GET http://10.1.110.2/PortalJsonAction.do?<params>&viewStatus=1
#      -> JSON with portalconfig{timestamp,uuid,sign},
#         serverForm{serverip(=wlanacIp),portalVer},
#         portalForm{mac,vlan,wlanacname,wlanuserip}
#   3) GET http://10.1.110.2/quickauth.do?userid=..&passwd=..&<params from
#      step 2>&timestamp=..&uuid=..   (plaintext GET; authByRas=false in
#      this deployment, so no RSA)
#      -> code=0 success, 201 already online, -1 fail (retryable),
#         236/237/238 need device binding (manual action required)
#   4) Logout: POST /quickauthdisconn.do with wlanacip/wlanuserip/
#      wlanacname/version/portaltype/userid/mac/groupId
#
# The daemon (campus-auth) runs from procd:
#   - detects the router's WAN IP / AC name / MAC by probing the hijack GW
#   - logs in with credentials from UCI (campusauth.@login[0])
#   - re-checks every CHECK_INTERVAL; re-auths when kicked
#
# UCI config (/etc/config/campusauth):
#   config login 'login'
#     option username '...'
#     option password '...'
#     option enabled '1'
#     option interval '90'          # seconds between online checks
#   config portal 'portal'
#     option portal_ip '10.1.110.2' # override if AC IP differs
#
# NOTE: credentials live in /etc/config/campusauth (root-only, 0600).

PORTAL_IP=$(uci -q get campusauth.portal.portal_ip || echo "10.1.110.2")
CONF=/etc/config/campusauth

# --- 1) init script: procd service --------------------------------------
mkdir -p /etc/init.d
cat > /etc/init.d/campus-auth <<'INITEOF'
#!/bin/sh /etc/rc.common
# campus portal auto-login daemon
START=99
STOP=15
USE_PROCD=1

PROG=/usr/bin/campus-auth

start_service() {
	[ "$(uci -q get campusauth.login.enabled)" = "1" ] || {
		logger -t campus-auth "disabled in uci (campusauth.login.enabled != 1); not starting"
		return 0
	}
	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param pidfile /var/run/campus-auth.pid
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger campusauth
}

reload_service() {
	stop
	start
}
INITEOF
chmod +x /etc/init.d/campus-auth

# --- 2) auth daemon ------------------------------------------------------
mkdir -p /usr/bin
cat > /usr/bin/campus-auth <<'DAEMONEOF'
#!/bin/sh
# campus portal auto-login daemon (procd supervised)
# Writes state to /tmp/campus-auth.status for the LuCI page.
#
# Config (enabled/interval/credentials/portal_ip) is re-read EVERY cycle so
# LuCI edits take effect even if the procd reload trigger chain fails.

STATUS_FILE=/tmp/campus-auth.status
# ban persistence: the AC's proxy-behavior ban is MAC-keyed and survives
# daemon/router restarts. Keeping BAN_UNTIL only in memory meant a procd
# respawn (or a reboot) walked straight back into quickauth during the ban -
# and each attempt during a ban RE-MARKS the MAC (v2.8.0 note). Persist the
# expiry epoch so any restarted daemon stays silent until it lapses.
BAN_UNTIL_FILE=/tmp/campus-auth.banuntil
UA="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36"

log() { logger -t campus-auth "$1"; }
set_status() { echo "$1" > "$STATUS_FILE"; }

# sleep with human-like jitter: a fixed 90s loop is a stopwatch signature.
# v2.9: widened to ±35% (was ±20%) - with the steady-state probe traffic
# removed, the sleep cadence itself is the last periodic signature left;
# ±20% of 90s still clusters tightly around 90, ±35% spreads 58..122s.
jittered_sleep() {
	local base jitter s
	base=${1:-90}
	case "$base" in ''|*[!0-9]*) base=90 ;; esac
	jitter=$(( base * 7 / 20 ))
	[ "$jitter" -lt 1 ] && jitter=1
	# busybox 无 $RANDOM：用 PID+秒/分的低位混合，凑一个 -jitter..+jitter 的散布
	s=$(( ( $$ * 7 + $(date +%S) * 13 + $(date +%M) * 29 ) % ( jitter * 2 + 1 ) - jitter ))
	# NOTE: 不再把负 s 钳成 0（v2.7.0~v2.8.1 的老 bug：钳位后只剩单侧
	# +0~+20% 抖动，基准值仍高度可预测）。下限由最后一行的 sleep 三元保护。
	sleep $(( base + s > 5 ? base + s : 5 ))
}

# off-campus backoff: consecutive rounds with the campus portal entirely
# absent (gateway silent AND probes dead AND no hijack). Each miss multiplies
# the sleep (up to 10x the interval); any sign of the campus network (gateway
# answers, hijack redirect seen) resets it to 0. This is what stops the
# daemon from hammering external probe URLs every 90s while the router sits
# on a mobile/CMCC WiFi hotspot - the very "proxy behavior" traffic pattern
# that got the account flagged.
OFFCAMPUS_STRIKES=0

# refresh uci-derived settings (called each loop iteration)
read_config() {
	PORTAL_IP=$(uci -q get campusauth.portal.portal_ip || echo "10.1.110.2")
	INTERVAL=$(uci -q get campusauth.login.interval || echo "90")
	ENABLED=$(uci -q get campusauth.login.enabled || echo "0")
	USERID=$(uci -q get campusauth.login.username)
	PASSWD=$(uci -q get campusauth.login.password)
	ACTIVE_START=$(uci -q get campusauth.login.active_start)
	ACTIVE_END=$(uci -q get campusauth.login.active_end)
	# day_N: 1 = run on that weekday (date +%w: 0=Sun .. 6=Sat). All unset
	#   -> every day (fail-open, same policy as the time window).
	DAYS=""
	local d
	for d in 0 1 2 3 4 5 6; do
		[ "$(uci -q get campusauth.login.day_$d)" = "1" ] && DAYS="$DAYS $d"
	done
}
read_config

# Is today an enabled weekday? (empty DAYS -> all days enabled)
is_active_day() {
	[ -z "${DAYS// /}" ] && return 0
	case " $DAYS " in
		*" $(date '+%w') "*) return 0 ;;
	esac
	return 1
}

# date +%w (0=Sun..6=Sat) -> Chinese weekday name for status text
weekday_cn() {
	case "$1" in
		0) echo "周日" ;;
		1) echo "周一" ;;
		2) echo "周二" ;;
		3) echo "周三" ;;
		4) echo "周四" ;;
		5) echo "周五" ;;
		6) echo "周六" ;;
		*) echo "?" ;;
	esac
}

# Is the current wall-clock time inside the active window?
#   empty start/end        -> always active (default)
#   start < end (07:00-23:30) -> same-day window
#   start > end (22:00-06:00) -> overnight window (wraps midnight)
# HH:MM with leading zeros compares correctly as a plain string.
# Any malformed value -> treat as always-active (fail open: auth keeps
# working when someone typos the config; a fail-closed daemon would sit
# silently through a perfectly good network window).
in_active_window() {
	local now start end
	now=$(date '+%H:%M')
	start=${ACTIVE_START:-}
	end=${ACTIVE_END:-}
	[ -z "$start" ] || [ -z "$end" ] && return 0
	# validate HH:MM (busybox date always emits valid HH:MM; config might not)
	echo "$start$end" | grep -q '[^0-9:]' && return 0
	case "$start:$end" in
		[0-2][0-9]:[0-5][0-9]:[0-2][0-9]:[0-5][0-9]) ;;
		*) return 0 ;;
	esac
	if [ "$start" = "$end" ]; then
		return 0
	fi
	# test(1) has no >= operator; "not less-than" is the portable form
	# (verified against busybox ash AND bash: `\>=` silently errors).
	if [ "$start" \< "$end" ]; then
		# same-day window: start <= now < end
		[ "$now" \< "$end" ] && [ ! "$now" \< "$start" ] && return 0
		return 1
	else
		# overnight window (wraps midnight): now >= start OR now < end
		[ ! "$now" \< "$start" ] && return 0
		[ "$now" \< "$end" ] && return 0
		return 1
	fi
}

# Rough "force-disconnect hours" guess for STATUS TEXT ONLY (never gates
# behavior): the campus cuts HTTP+DNS on weeknights from ~23:30; recovery
# around 06:30. Outside those hours an HTTP-dead-with-ICMP-alive result is
# more likely an upstream DNS outage (see dnsmasq concurrent-query floods)
# than the scheduled disconnect - the status text should say so instead of
# blaming the disconnect window at, say, Friday 18:19.
looks_like_maintenance_window() {
	local h
	h=$(date '+%H')
	case "$h" in
		23|00|01|02|03|04|05|06) return 0 ;;
		*) return 1 ;;
	esac
}

# fetch url -> stdout (uclient-fetch; wget is its alias on OpenWrt).
# NOTE: uclient-fetch has NO --header option (unlike GNU wget). Passing
# --header makes it print usage and exit non-zero - v2.7.0/2.7.1 shipped
# exactly that bug and every fetch silently failed, so the daemon could
# never see the hijack redirect and auto-auth never ran (log showed the
# misleading "HTTP dead, ICMP alive"). Only --user-agent is supported;
# request-header consistency beyond UA has to happen at the client level.
fetch() {
	uclient-fetch -q -T 8 --user-agent "$UA" -O - "$1" 2>/dev/null
}

# probe the hijack gateway to learn our session params:
# any http:// request returns a JS redirect containing the full portal URL.
# We use the status API afterwards to get the authoritative portalForm.
# Results are passed via globals (NOT stdout - callers must not invoke this
# inside $(...) or the PROBE_HTTP side effect is lost to the subshell):
#   PROBE_REDIRECT  portal.do URL when hijacked, else empty
#   PROBE_HTTP      1 when a hijack target answered at all (distinguishes
#                  "answered but no hijack" from "unreachable")
#   PROBE_NOTE      short reason when the AC answered with a REJECTION page
#                  instead of a redirect (user-verified: during the nightly
#                  force-disconnect the AC serves "该时间段不在可用区间"
#                  style text on 3.3.3.3) - surfaced as the maintenance
#                  status instead of the generic probe-failed text
PROBE_REDIRECT=""
PROBE_HTTP=0
PROBE_NOTE=""
# hijack probe targets, in order. The AC hijacks ANY http:// request on port
# 80 while the session is unauthenticated (the campus notice board itself
# tells users to type http://3.3.3.3 to reach the portal). 10.0.0.1 was the
# classic hijack gateway but is NOT guaranteed to hijack on every AC config
# (and foreign networks squat on it); 3.3.3.3 is the campus-documented
# entry that no legitimate upstream would answer, so a portal.do redirect
# from it is a near-certain unauthenticated-campus signal.
HIJACK_PROBES="3.3.3.3 10.0.0.1"
# AC rejection-page keywords (byte-level grep on UTF-8 works in busybox).
# The exact wording is unknown beyond the user's paraphrase ("该时间段不在
# 可用区间，类似于这种话") so match on any of a handful of broad terms.
MAINT_KEYWORDS="不在可用 可用区间 时间段 暂停 停机 维护"
probe_params() {
	local body redirect p kw
	PROBE_REDIRECT=""
	PROBE_HTTP=0
	PROBE_NOTE=""
	for p in $HIJACK_PROBES; do
		body=$(fetch "http://$p/") || body=""
		[ -n "$body" ] && PROBE_HTTP=1
		redirect=$(echo "$body" | grep -o 'http://[^"]*portal\.do[^"]*' | head -1)
		if [ -n "$redirect" ]; then
			# While AUTHENTICATED the same probe targets redirect to the
			# LOGOUT page instead (user-verified: authenticated, 3.3.3.3 ->
			# portalLogout.do "认证成功" screen). That is NOT a login
			# hijack: following it would make the daemon fire quickauth
			# every cycle (201 already-online loop) - exactly the
			# behavior-anomaly this daemon exists to avoid. Only a
			# portal.do LOGIN redirect counts as "needs auth"; anything
			# with "logout" in it means we are online.
			case "$redirect" in
				*[Ll]ogout*|*LOGOUT*) PROBE_REDIRECT=""; return 1 ;;
			esac
			PROBE_REDIRECT="$redirect"
			return 0
		fi
		# no redirect: is this the nightly rejection page? (answered but
		# "not in the available time window"). First matching keyword wins.
		if [ "$PROBE_HTTP" = "1" ] && [ -z "$PROBE_NOTE" ]; then
			for kw in $MAINT_KEYWORDS; do
				if echo "$body" | grep -q "$kw"; then
					PROBE_NOTE="$kw"
					break
				fi
			done
		fi
	done
	return 1
}

# Cached wrapper around check_online for cycles where the steady-state
# pre-check already ran it (see main loop). Re-running the full probe set
# twice in one cycle doubles the periodic external footprint for zero new
# information - the NET_HIJACK/NET_ICMP globals from the pre-check run are
# still valid within the same iteration.
PRECHECK_RAN=0
PRECHECK_RC=1
check_online_cached() {
	if [ "$PRECHECK_RAN" = "1" ]; then
		return "$PRECHECK_RC"
	fi
	check_online
}

# internet reachability check. A plain ICMP probe is NOT enough: this campus
# force-disconnects users on weeknights (23:30+) while leaving ICMP to public
# IPs reachable - ping 223.5.5.5 answers while HTTP and DNS are both dead
# (ping qq.com / baidu.com fails: name resolution dies with the network).
# Probe the HTTP layer via generate_204 endpoints instead:
#   - real online        -> HTTP 204, empty body, exit 0
#   - unauthenticated    -> hijacked to the portal page (body has portal.do)
#   - force-disconnected -> DNS/connect failure, non-zero exit
# Globals (same subshell caveat as probe_params):
#   NET_HIJACK  1 when the response looked like the portal hijack page
#   NET_ICMP    1 when ICMP to a public IP still answers (diagnostic only)
NET_HIJACK=0
NET_ICMP=0
check_online() {
	NET_HIJACK=0; NET_ICMP=0; NET_DNS=0
	local body rc
	# Layer order (cheapest/most-reliable signal first for THIS campus):
	#
	# 1. DNS layer: ping a DOMAIN. The campus force-disconnect AND the
	#    unauthenticated state both kill DNS (ping qq.com gets nothing),
	#    so a resolving ping means the full stack (DNS + ICMP) works -
	#    that only happens when online. This is the user-observable
	#    definition of "internet works" and needs no HTTP probe at all.
	#    (ping exits 1 on NXDOMAIN/timeout alike - good enough here.)
	ping -c 1 -W 4 qq.com >/dev/null 2>&1 && { NET_DNS=1; return 0; }
	# 2. HTTP layer via generate_204 (still tried when DNS ping failed:
	#    dnsmasq may hold a cached A record while the DNS forwarder is
	#    dead, and mobile upstreams resolve but block ICMP). miui first:
	#    China-mobile IP, direct domestic route; ustclug sits behind
	#    Cloudflare, which campus networks rate-limit at peak hours.
	#    While in off-campus backoff these external probes are SKIPPED
	#    entirely (see OFFCAMPUS_STRIKES).
	for url in "http://connect.rom.miui.com/generate_204" \
	           "http://204.ustclug.org/generate_204"; do
		body=$(uclient-fetch -q -T 8 --user-agent "$UA" -O - "$url" 2>/dev/null)
		rc=$?
		if [ $rc -eq 0 ]; then
			# got an HTTP response. A hijacking AC follows the redirect
			# chain and lands on the portal page (uclient-fetch follows
			# redirects by itself, exit 0); the portal JS contains
			# portal.do. A clean 204 has an empty body.
			if echo "$body" | grep -q 'portal\.do'; then
				NET_HIJACK=1
				return 1
			fi
			return 0
		fi
		# rc!=0: DNS resolution failure, connection-level failure (4) or
		# non-2xx (8). Could also be "this single endpoint is down" or
		# "DNS flaky while online" - try the next probe before giving up.
	done
	# 3. both HTTP probes dead. IP-direct diagnostics (neither needs DNS):
	#   NET_ICMP  ICMP echo to a public IP - NOT an online signal: the
	#             unauthenticated campus passes ICMP to IPs while killing
	#             HTTP+DNS (user-verified: unauthenticated, ping 223.5.5.5
	#             OK, ping qq.com dead, http://3.3.3.3 hijacked to portal).
	#             Pure failure-text refinement.
	ping -c 1 -W 3 223.5.5.5 >/dev/null 2>&1 && NET_ICMP=1
	return 1
}

# TCP handshake check without DNS: uses busybox nc if present, else a
# uclient-fetch to the telnet-style port as a last resort. Returns 0 when
# the TCP connection to $1:$2 could be established.
tcp_ok() {
	if command -v nc >/dev/null 2>&1; then
		nc -z -w 3 "$1" "$2" >/dev/null 2>&1 && return 0
		return 1
	fi
	# no nc: uclient-fetch against the DNS-over-TCP port; any TCP-level
	# response (even a protocol error exit) means the handshake worked.
	# exit 4 = connection failed/timeout, exit 8/0 = server answered.
	uclient-fetch -q -T 3 -O /dev/null "http://$1:$2/" >/dev/null 2>&1
	case $? in
		0|8) return 0 ;;
		*) return 1 ;;
	esac
}

# GET PortalJsonAction.do and echo raw JSON
portal_status() {
	local url="$1"
	fetch "http://$PORTAL_IP/PortalJsonAction.do?$url&viewStatus=1"
}

# percent-encode chars that break query strings (& % + # space etc.)
urlencode() {
	echo "$1" | sed -e 's/%/%25/g' -e 's/&/%26/g' -e 's/+/%2B/g' -e 's/#/%23/g' -e 's/ /%20/g' -e 's/?/%3F/g'
}

json_get() {
	# json_get '<json>' '<key>' -> value (simple regex, no shell json deps)
	echo "$1" | grep -o "\"$2\"[[:space:]]*:[[:space:]]*\"\{0,1\}[^\"]*\"*[,}]" \
		| head -1 | sed "s/.*:[[:space:]]*//;s/[\",}]//g"
}

AUTH_OK=0
ONLINE_STAMP=0

# restore a persisted ban (MAC-keyed AC bans survive daemon restarts):
# without this, procd respawn after a crash / `service campus-auth restart`
# / reboot walks straight back into quickauth mid-ban and re-marks the MAC.
BAN_UNTIL=0
if [ -f "$BAN_UNTIL_FILE" ]; then
	BAN_UNTIL=$(cat "$BAN_UNTIL_FILE" 2>/dev/null)
	case "$BAN_UNTIL" in ''|*[!0-9]*) BAN_UNTIL=0 ;; esac
	if [ "$BAN_UNTIL" -gt 0 ] && [ "$(date +%s)" -ge "$BAN_UNTIL" ]; then
		BAN_UNTIL=0
		rm -f "$BAN_UNTIL_FILE"
	fi
	[ "$BAN_UNTIL" -gt 0 ] && log "resumed persisted ban (until $(date -d @${BAN_UNTIL} '+%H:%M:%S' 2>/dev/null || date '+%H:%M:%S'))"
fi

while true; do
	# re-read settings each cycle: LuCI edits apply within one interval even
	# if the procd reload trigger chain fails for whatever reason
	read_config

	if [ "$ENABLED" != "1" ]; then
		set_status "disabled（未启用自动认证） $(date '+%Y-%m-%d %H:%M:%S')"
		sleep "$INTERVAL"
		continue
	fi

	# active window: pause all probing/login outside the configured
	# hours (e.g. 07:00-23:30 so the daemon sleeps through the campus
	# force-disconnect window instead of retrying all night). Keep
	# AUTH_OK as-is: re-entering the window re-runs the full state
	# machine anyway (check_online / hijack paths both handle it).
	# Weekday gate first (date +%w of the CURRENT moment - an overnight
	# window crossing midnight belongs to the new day after 00:00).
	if ! is_active_day; then
		set_status "paused（今日（$(weekday_cn "$(date '+%w')")）不运行，暂停探测） $(date '+%Y-%m-%d %H:%M:%S')"
		sleep "$INTERVAL"
		continue
	fi
	if ! in_active_window; then
		set_status "paused（超出运行时段 ${ACTIVE_START}-${ACTIVE_END}，暂停探测） $(date '+%Y-%m-%d %H:%M:%S')"
		sleep "$INTERVAL"
		continue
	fi

	# --- persisted-ban gate -------------------------------------------
	# The AC's proxy-behavior ban is keyed to the WAN MAC and survives
	# everything on our side. While it stands, the correct posture is the
	# same as the inline ban sleep in the auth path below: total silence -
	# no hijack probes, no generate_204, no quickauth. Probing looks like
	# ordinary browser traffic and does not lift the ban; authenticating
	# does and re-marks the MAC.
	if [ "$BAN_UNTIL" -gt 0 ]; then
		if [ "$(date +%s)" -ge "$BAN_UNTIL" ]; then
			BAN_UNTIL=0
			rm -f "$BAN_UNTIL_FILE"
			set_status "ban-expired（代理行为封禁已到期，恢复正常认证流程） $(date '+%Y-%m-%d %H:%M:%S')"
			log "ban expired; resuming normal auth flow"
		else
			set_status "banned（代理行为封禁静默期，至 $(date -d @${BAN_UNTIL} '+%H:%M:%S' 2>/dev/null || date '+%H:%M:%S')；期间零探测零认证，勿手动登录） $(date '+%Y-%m-%d %H:%M:%S')"
			jittered_sleep $(( INTERVAL > 60 ? INTERVAL : 60 ))
			continue
		fi
	fi

	# --- steady-state fast path ---------------------------------------
	# v2.9: when we are already online, one ping to qq.com per cycle is the
	# ONLY steady-state probe. Previously every cycle ran probe_params (two
	# hijack HTTP probes - the AC answers authenticated sessions with a
	# portalLogout.do redirect, so this traffic never looked like a human
	# browser) plus a duplicated check_online in the pre-auth branch. With
	# the fast path a healthy session emits: 1 DNS query + 1 ICMP echo,
	# jittered ±35% - indistinguishable from OS-level captive-portal checks.
	# Skipped while off-campus backoff is active (strikes >= 3): external
	# probes must stay fully silent there, and the backoff branch below
	# still runs its cheap gateway probe first.
	PRECHECK_RAN=0
	if [ "$OFFCAMPUS_STRIKES" -lt 3 ] && [ "$AUTH_OK" = "1" ]; then
		check_online
		PRECHECK_RC=$?
		PRECHECK_RAN=1
		if [ "$PRECHECK_RC" -eq 0 ]; then
			ONLINE_STAMP=$(date +%s)
			set_status "online(稳态) $(date '+%Y-%m-%d %H:%M:%S')"
			jittered_sleep "$INTERVAL"
			continue
		fi
	fi

	# off-campus backoff: after several consecutive rounds where the
	# campus gateway AND portal are both completely silent (router sits
	# on a mobile/other WiFi), stretch the sleep multiplicatively. Any
	# campus sign (gateway answer, hijack, portal response) resets it.
	# The multiplier caps at 10x; check_online's external probes are
	# also skipped once strikes >= 3 so a non-campus network never sees
	# the periodic generate_204 pattern at all.
	BACKOFF=1
	if [ "$OFFCAMPUS_STRIKES" -ge 3 ]; then
		BACKOFF=$(( OFFCAMPUS_STRIKES > 10 ? 10 : OFFCAMPUS_STRIKES ))
	fi

	# --- gather session params ----------------------------------------
	# The hijack gateway only answers with a portal.do redirect while the
	# session is UNAUTHENTICATED. Once online (e.g. MAC-based silent auth:
	# same WAN MAC as last session), 10.0.0.1 stops hijacking - which itself
	# is a "no auth needed" signal. Verify with an HTTP reachability probe
	# before declaring anything, so a silently-authenticated router (fresh
	# boot, AUTH_OK still 0) is not misreported as "probe-failed".
	# NOTE: check_online runs EVERY cycle (also when AUTH_OK=1): this campus
	# force-disconnects on weeknights 23:30+ while ICMP still answers, so a
	# ping-based check would show "online" through a dead HTTP layer.
	# Off-campus gate: with strikes >= 3 the campus gateway has been silent
	# for a while - probing it once more is cheap (LAN-side, goes nowhere on
	# a foreign network), but the EXTERNAL probes inside check_online are
	# what leak the periodic pattern, so skip them entirely.
	if [ "$OFFCAMPUS_STRIKES" -ge 3 ]; then
		probe_params
		REDIRECT="$PROBE_REDIRECT"
		if [ -z "$REDIRECT" ] && [ "$PROBE_HTTP" != "1" ]; then
			# still no campus gateway: remain in backoff, no external traffic
			OFFCAMPUS_STRIKES=$(( OFFCAMPUS_STRIKES + 1 ))
			set_status "off-campus（未检测到校园网关，退避探测中 x${OFFCAMPUS_STRIKES}） $(date '+%Y-%m-%d %H:%M:%S')"
			jittered_sleep $(( INTERVAL * BACKOFF ))
			continue
		fi
		# gateway answered: campus network is back - fall through, reset below
		OFFCAMPUS_STRIKES=0
	else
		probe_params
		REDIRECT="$PROBE_REDIRECT"
	fi
	if [ -z "$REDIRECT" ]; then
		if [ "$AUTH_OK" = "1" ] && check_online_cached; then
			# authenticated earlier and HTTP layer still works: stay online.
			# check_online each cycle (not just on first detection) - the
			# campus force-disconnects on weeknights while ICMP stays up,
			# which a ping-only check would misreport as online.
			set_status "online(no-hijack) $(date '+%Y-%m-%d %H:%M:%S')"
		elif [ "$AUTH_OK" != "1" ] && check_online_cached; then
			# hijack gone AND internet reachable: silently authenticated
			# (MAC auth) or otherwise exempted - nothing to do
			AUTH_OK=1; ONLINE_STAMP=$(date +%s)
			set_status "online(mac-auth/免认证) $(date '+%Y-%m-%d %H:%M:%S')"
			log "no hijack but internet reachable - already authenticated (mac-auth?)"
		elif [ "$NET_HIJACK" = "1" ]; then
			# check_online saw the portal page without a hijack redirect
			# from 10.0.0.1 - the AC is mid-transition; retry next cycle
			set_status "portal-transition（检测到劫持页，等待下轮探测） $(date '+%Y-%m-%d %H:%M:%S')"
		elif [ "$AUTH_OK" = "1" ]; then
			# was online, HTTP layer now dead. Distinguish by NET_ICMP:
			#  - ICMP alive (223.5.5.5 answers, qq.com no longer resolves):
			#    the weeknight force-disconnect window (23:30+). AC keeps
			#    ICMP but kills HTTP+DNS.
			#  - ICMP dead too: total outage.
			# Either way reset AUTH_OK so the full auth path re-runs the
			# moment the AC starts hijacking again (network is back).
			AUTH_OK=0
			if [ "$NET_ICMP" = "1" ]; then
				if looks_like_maintenance_window; then
					set_status "disconnected（HTTP/DNS 已断（疑似停机时段），ICMP 仍通；恢复后自动重连） $(date '+%Y-%m-%d %H:%M:%S')"
				else
					set_status "disconnected（HTTP/DNS 已断（非停机时段：疑似上游 DNS 故障或网络异常），ICMP 仍通；持续探测中） $(date '+%Y-%m-%d %H:%M:%S')"
				fi
			else
				set_status "disconnected（外网完全不可达；恢复后自动重连） $(date '+%Y-%m-%d %H:%M:%S')"
			fi
			log "online->disconnected: HTTP probes dead (icmp=$NET_ICMP; maintenance_window=$(looks_like_maintenance_window && echo yes || echo no))"
		elif [ "$NET_ICMP" = "1" ]; then
			# never authenticated this session and HTTP is dead while ICMP
			# answers. Inside maintenance hours: the scheduled disconnect.
			# Outside them (e.g. a Friday evening): an upstream DNS outage
			# or upstream filter - either way not an auth problem and not
			# something a login attempt would fix. Keep probing.
			if looks_like_maintenance_window; then
				set_status "disconnected（HTTP/DNS 已断（疑似停机时段），ICMP 仍通） $(date '+%Y-%m-%d %H:%M:%S')"
				log "HTTP dead, ICMP alive (maintenance window); not an auth issue"
			else
				set_status "disconnected（HTTP/DNS 已断（非停机时段：疑似上游 DNS 故障），ICMP 仍通；持续探测中） $(date '+%Y-%m-%d %H:%M:%S')"
				log "HTTP dead, ICMP alive (outside maintenance hours - upstream DNS outage?); keep probing"
			fi
		elif [ -n "$PROBE_NOTE" ]; then
			# the AC ANSWERED with a rejection page ("该时间段不在可用区间"
			# style, user-verified during the nightly disconnect) instead of
			# a login redirect: the campus net is up but closed for the
			# night. Nothing to authenticate against - wait quietly.
			AUTH_OK=0
			set_status "maintenance（校园网停机中（AC 应答：${PROBE_NOTE}），到点自动恢复认证） $(date '+%Y-%m-%d %H:%M:%S')"
			log "AC rejection page matched '${PROBE_NOTE}'; maintenance window"
		elif [ "$PROBE_HTTP" = "1" ]; then
			# gateway answered but no portal.do redirect and no internet:
			# portal moved or hijack format changed - worth a log line
			set_status "probe-failed（网关应答但无劫持跳转且外网不通） $(date '+%Y-%m-%d %H:%M:%S')"
			log "gateway answered without portal.do redirect; internet unreachable"
		else
			set_status "offline（网关不可达，外网不通） $(date '+%Y-%m-%d %H:%M:%S')"
			log "hijack gateway probe failed (gateway down or portal moved)"
		fi
		# Off-campus scoring. Counting a strike when the campus network is
		# nowhere in sight:
		#   - all hijack probes silent (PROBE_HTTP=0): not on the campus net
		#   - a probe ANSWERED but no portal.do redirect AND external HTTP
		#     probes also failed: not "authenticated and online" (that
		#     would have returned in the check_online branches above) - a
		#     foreign router squatting on the probe IP (mobile hotspots
		#     and carrier gateways love 10.0.0.1) with a broken/slow DNS
		#     upstream. v2.7.1 and earlier reset the backoff on ANY probe
		#     answer, so a mobile-WiFi upstream kept the daemon probing at
		#     full cadence forever. Only a hijack redirect or a working
		#     internet resets the counter now.
		if [ "$PROBE_HTTP" != "1" ]; then
			OFFCAMPUS_STRIKES=$(( OFFCAMPUS_STRIKES + 1 ))
		elif [ -n "$PROBE_NOTE" ]; then
			# AC rejection page: definitively ON the campus net (nothing
			# else would serve that text) - never back off from it
			OFFCAMPUS_STRIKES=0
		elif [ "$NET_HIJACK" != "1" ] && ! tcp_ok 223.5.5.5 53; then
			# probe answered, no hijack, and even TCP to a public IP
			# fails -> foreign network or dead upstream: back off.
			OFFCAMPUS_STRIKES=$(( OFFCAMPUS_STRIKES + 1 ))
		else
			OFFCAMPUS_STRIKES=0
		fi
		jittered_sleep $(( INTERVAL * BACKOFF ))
		continue
	fi
	# campus gateway alive (hijack redirect or answered): reset backoff
	OFFCAMPUS_STRIKES=0

	# pre-auth online check: an authenticated session can still produce a
	# login-shaped redirect from the probe targets in edge cases (AC
	# mid-transition, stale hijack cache). Firing quickauth every cycle is
	# the behavior anomaly this daemon must avoid, so confirm we actually
	# CANNOT reach the internet before authenticating. ping qq.com first
	# (cheap, no HTTP), generate_204 fallback inside check_online.
	# Cached when the steady-state pre-check already ran it this cycle -
	# the verdict cannot change within seconds and a second full probe
	# round doubles the external footprint for nothing.
	if check_online_cached; then
		AUTH_OK=1; ONLINE_STAMP=$(date +%s)
		set_status "online(劫持探测但外网可达，判定已在线) $(date '+%Y-%m-%d %H:%M:%S')"
		jittered_sleep "$INTERVAL"
		continue
	fi

	Q=$(echo "$REDIRECT" | sed 's/.*portal\..do?//')
	echo "$Q" > /tmp/campus-auth.params

	JSON=$(portal_status "$Q")
	if [ -n "$JSON" ]; then
		TIMESTAMP=$(json_get "$JSON" timestamp)
		UUID=$(json_get "$JSON" uuid)
		ACIP=$(echo "$JSON" | grep -o '"serverip"[[:space:]]*:[[:space:]]*"[^"]*"' | sed 's/.*: *"//;s/"//')
		USERIP=$(echo "$JSON" | grep -o '"wlanuserip"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | sed 's/.*: *"//;s/"//')
		ACNAME=$(echo "$JSON" | grep -o '"wlanacname"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | sed 's/.*: *"//;s/"//')
		MAC=$(echo "$JSON" | grep -o '"mac"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | sed 's/.*: *"//;s/"//')
		VLAN=$(echo "$JSON" | grep -o '"vlan"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | sed 's/.*: *"//;s/"//')

	# --- try login ------------------------------------------------
		if [ -z "$USERID" ] || [ -z "$PASSWD" ]; then
			set_status "no-credentials（学号或密码未设置） $(date '+%Y-%m-%d %H:%M:%S')"
			jittered_sleep "$INTERVAL"
			continue
		fi
		MAC_ENC=$(echo "$MAC" | sed 's/:/%3A/g')
		USERID_ENC=$(urlencode "$USERID")
		PASSWD_ENC=$(urlencode "$PASSWD")
		AUTH_URL="http://$PORTAL_IP/quickauth.do?userid=$USERID_ENC&passwd=$PASSWD_ENC&wlanuserip=$USERIP&wlanacname=$ACNAME&wlanacIp=$ACIP&ssid=&vlan=$VLAN&mac=$MAC_ENC&version=0&portalpageid=1&timestamp=$TIMESTAMP&uuid=$UUID&portaltype=0&hostname=&bindCtrlId="
		RESP=$(fetch "$AUTH_URL")
		CODE=$(json_get "$RESP" code)
		MSG=$(json_get "$RESP" message)

		# Ban detection: the campus anti-proxy system answers quickauth with
		# "发现您当前网络环境存在代理行为,禁用认证30分钟" style messages.
		# Re-authing during the ban is pointless (same MAC is already marked)
		# and each extra attempt can re-trigger the marker, so parse the
		# ban window and go silent until it expires.
		BAN_SECONDS=0
		case "$MSG" in
			*禁用*|*禁止*|*代理行为*|*封禁*)
				BAN_MIN=$(echo "$MSG" | grep -o '[0-9]\{1,4\} *分钟' | head -1 | grep -o '[0-9]\{1,4\}')
				case "$BAN_MIN" in
					''|*[!0-9]*) BAN_MIN=30 ;;  # default when no number parsed
				esac
				BAN_SECONDS=$(( BAN_MIN * 60 ))
				;;
		esac
		if [ "$BAN_SECONDS" -gt 0 ]; then
			BAN_UNTIL=$(( $(date +%s) + BAN_SECONDS + 60 ))  # +60s margin
			# persist: the AC ban is MAC-keyed and outlives the daemon -
			# a crash/respawn/reboot must not walk back into quickauth
			echo "$BAN_UNTIL" > "$BAN_UNTIL_FILE"
			set_status "banned（触发代理行为检测：${MSG}；认证禁至 $(date -d @${BAN_UNTIL} '+%H:%M:%S' 2>/dev/null || date '+%H:%M:%S')，期间静默不再尝试，到期自动恢复） $(date '+%Y-%m-%d %H:%M:%S')"
			log "auth banned by AC for ${BAN_MIN}min (proxy-behavior detection); going silent"
			# sleep in slices so uci edits (disable/interval) still apply;
			# the loop-top persisted-ban gate takes over if we respawn
			BAN_LEFT=$BAN_SECONDS
			while [ "$BAN_LEFT" -gt 0 ]; do
				jittered_sleep $(( BAN_LEFT > 300 ? 300 : BAN_LEFT ))
				read_config
				[ "$ENABLED" != "1" ] && break
				BAN_LEFT=$(( BAN_LEFT - 300 ))
			done
			AUTH_OK=0
			jittered_sleep "$INTERVAL"
			continue
		fi

		case "$CODE" in
			0)
				AUTH_OK=1; ONLINE_STAMP=$(date +%s)
				set_status "online $(date '+%Y-%m-%d %H:%M:%S') ip=$USERIP ac=$ACNAME"
				log "login ok (ip=$USERIP ac=$ACNAME)"
				;;
			201)
				AUTH_OK=1; ONLINE_STAMP=$(date +%s)
				set_status "online(already) $(date '+%Y-%m-%d %H:%M:%S') ip=$USERIP"
				log "already online (code=201)"
				;;
			236|237|238)
				set_status "bind-required code=$CODE $(date '+%Y-%m-%d %H:%M:%S')"
				log "portal requires device binding (code=$CODE); manual action needed"
				;;
			-1|"")
				set_status "failed code=$CODE $(date '+%Y-%m-%d %H:%M:%S')"
				log "login failed (code=$CODE), retrying"
				;;
			*)
				set_status "unknown code=$CODE $(date '+%Y-%m-%d %H:%M:%S')"
				log "portal returned code=$CODE"
				;;
		esac
	else
		set_status "no-portal-response $(date '+%Y-%m-%d %H:%M:%S')"
		log "PortalJsonAction unreachable"
	fi

	jittered_sleep "$INTERVAL"
done
DAEMONEOF
chmod +x /usr/bin/campus-auth

# --- 3) default UCI config (credentials empty - set via LuCI or uci) -----
touch "$CONF"
cat > "$CONF" <<'UCIEOF'
config login 'login'
	option enabled '0'
	option username ''
	option password ''
	option interval '90'
	option active_start ''
	option active_end ''
# day_N: 1 = run on that weekday (0=Sun 1=Mon .. 6=Sat); unset = all days
	option day_1 '1'
	option day_2 '1'
	option day_3 '1'
	option day_4 '1'
	option day_5 '1'
	option day_6 '1'
	option day_0 '1'

config portal 'portal'
	option portal_ip '10.1.110.2'
UCIEOF
chmod 600 "$CONF"

# --- 4) rpcd backend for the LuCI page -----------------------------------
mkdir -p /usr/share/rpcd/ucode
cat > /usr/share/rpcd/ucode/campusauth <<'UCEOF'
// campus-auth rpcd backend: status read + manual login/logout
'use strict';

import { readfile, popen } from 'fs';
import { cursor } from 'uci';

const q = "'";
const UA = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36';

function enc(s) {
	// percent-encode query-string-hostile chars (covers typical passwords)
	return replace(replace(replace(replace(replace(replace(s ?? '', '%', '%25'), '&', '%26'), '+', '%2B'), '#', '%23'), ' ', '%20'), '?', '%3F');
}

function fetch(url) {
	// uclient-fetch has NO --header option (v2.7.0-2.7.2 bug: passing it
	// made every fetch fail with a usage error, so the LuCI login button
	// and the daemon both silently broke). UA-only request.
	let p = popen('uclient-fetch -q -T 8 --user-agent ' + q + UA + q + ' -O - ' + q + url + q + ' 2>/dev/null');
	let out = p.read('all');
	p.close();
	return out ?? '';
}

function jget(json, key) {
	// ucode has no `new RegExp` - use the regexp() builtin instead
	let re = regexp('"' + key + '"\\s*:\\s*("([^"]*)"|[0-9]+|true|false|null)');
	let m = match(json, re);
	return m ? (m[2] ?? m[1]) : null;
}

// rpcd ucode plugins must return:
//   { <ubus-object-name>: { <method>: { call: fn, args: {...} }, ... } }
// (see rpcd ucode.c rpc_ucode_script_validate: the top-level key IS the
// ubus object name, the second level are method definitions). The official
// luci plugin does `return { luci: methods }` - we mirror that shape with
// the object name `campusauth` so the LuCI page's rpc.declare calls resolve.
return {
	campusauth: {
		status: {
			call: function(request, args) {
				let st = trim(readfile('/tmp/campus-auth.status') ?? '');
				let uci = cursor();

				// is the daemon process actually up? procd writes the
				// instance pidfile; a shell script's comm is "sh", so
				// pgrep -x would never match - check the pidfile instead.
				let running = false;
				let pid = trim(readfile('/var/run/campus-auth.pid') ?? '');
				if (pid) {
					let p = popen('kill -0 ' + pid + ' 2>/dev/null && echo up');
					if (p) {
						running = trim(p.read('all') ?? '') == 'up';
						p.close();
					}
				}

				if (!running && st == '')
					st = '未运行（未启用自动认证）';

				return {
					status: st || 'unknown',
					running: running,
					enabled: uci.get('campusauth', 'login', 'enabled') || '0',
					username: uci.get('campusauth', 'login', 'username') || '',
					has_password: (uci.get('campusauth', 'login', 'password') || '') != '',
					interval: uci.get('campusauth', 'login', 'interval') || '90',
					active_start: uci.get('campusauth', 'login', 'active_start') || '',
					active_end: uci.get('campusauth', 'login', 'active_end') || '',
					days: ['1','2','3','4','5','6','0'].filter(d => uci.get('campusauth', 'login', 'day_' + d) == '1'),
					portal_ip: uci.get('campusauth', 'portal', 'portal_ip') || '10.1.110.2'
				};
			}
		},

		login: {
			// force one immediate auth attempt (daemon picks it up next cycle,
			// or we do an inline attempt for instant feedback)
			call: function(request, args) {
				let uci = cursor();
				let userid = uci.get('campusauth', 'login', 'username');
				let passwd = uci.get('campusauth', 'login', 'password');
				let portal_ip = uci.get('campusauth', 'portal', 'portal_ip') || '10.1.110.2';

				if (!userid || !passwd)
					return { code: null, error: '学号或密码未设置' };

				// persisted-ban guard: the AC ban is MAC-keyed and every
				// quickauth attempt during it re-marks the MAC. The daemon
				// goes silent, but the LuCI "立即认证" button is user-driven -
				// block it here too so a well-meaning click cannot extend
				// the punishment.
				// NOTE: no ucode time builtins (time()/localtime() signatures
				// differ across libucode versions) - shell out to date, which
				// the daemon itself uses for the same arithmetic.
				// int('') returns null and null < N is numerically TRUE in
				// ucode, so both sides must be null-checked or a popen
				// failure would wrongly block login forever.
				let ban_until = trim(readfile('/tmp/campus-auth.banuntil') ?? '');
				if (ban_until && match(ban_until, /^[0-9]+$/)) {
					let p = popen('echo "$(date +%s) $(date -d @' + ban_until + ' "+%H:%M:%S" 2>/dev/null)"');
					let out = trim(p ? (p.read('all') ?? '') : '');
					if (p) p.close();
					let parts = split(out, ' ');
					let now_s = int(parts[0]);
					let until_s = int(ban_until);
					if (now_s != null && until_s != null && now_s < until_s)
						return { code: null, error: '代理行为封禁中（至 ' + (parts[1] ?? '?') + '），请勿重复尝试认证，到期后守护进程自动恢复' };
				}

				// probe hijack targets for session params (same order and
				// rationale as the daemon's HIJACK_PROBES: 3.3.3.3 first -
				// the campus-documented portal entry - then 10.0.0.1).
				// While authenticated the probes redirect to the LOGOUT page
				// (portalLogout.do) - that is not a login hijack, skip it.
				let redirect = null;
				for (let probe in ['3.3.3.3', '10.0.0.1']) {
					let body = fetch('http://' + probe + '/');
					let m = match(body ?? '', /http:\/\/[^"']*portal\.do\?[^"']*/);
					if (m && !match(m[0], /[Ll]ogout/)) {
						redirect = m;
						break;
					}
				}
				if (!redirect)
					return { code: null, error: '无法获取认证参数（可能已在线或网关不可达）' };

				let qp = split(substr(redirect[0], index(redirect[0], '?') + 1), '&');
				let params = {};
				for (let kv in qp) {
					let i = index(kv, '=');
					if (i > 0)
						params[substr(kv, 0, i)] = substr(kv, i + 1);
				}

				let url = 'http://' + portal_ip + '/PortalJsonAction.do?' +
					'wlanuserip=' + (params.wlanuserip ?? '') +
					'&wlanacname=' + (params.wlanacname ?? '') +
					'&mac=' + (params.mac ?? '') +
					'&vlan=' + (params.vlan ?? '') +
					'&viewStatus=1';
				let json = fetch(url);
				if (!json)
					return { code: null, error: 'PortalJsonAction 无响应' };

				let ts = jget(json, 'timestamp');
				let uuid = jget(json, 'uuid');
				let acip = jget(json, 'serverip');
				let userip = jget(json, 'wlanuserip');
				let acname = jget(json, 'wlanacname');
				let mac = jget(json, 'mac');
				let vlan = jget(json, 'vlan');

				if (!ts || !uuid)
					return { code: null, error: 'portal 配置解析失败' };

				let auth_url = 'http://' + portal_ip + '/quickauth.do?userid=' + enc(userid) +
					'&passwd=' + enc(passwd) +
					'&wlanuserip=' + userip + '&wlanacname=' + acname +
					'&wlanacIp=' + acip + '&ssid=&vlan=' + vlan +
					'&mac=' + replace(mac ?? '', ':', '%3A') + '&version=0&portalpageid=1' +
					'&timestamp=' + ts + '&uuid=' + uuid +
					'&portaltype=0&hostname=&bindCtrlId=';
				let resp = fetch(auth_url);
				let code = jget(resp, 'code');
				let message = jget(resp, 'message');

				return { code: code, message: message };
			}
		},

		logout: {
			call: function(request, args) {
				let uci = cursor();
				let portal_ip = uci.get('campusauth', 'portal', 'portal_ip') || '10.1.110.2';
				let userid = uci.get('campusauth', 'login', 'username') || '';

				let qp = trim(readfile('/tmp/campus-auth.params') ?? '');
				let p = {};
				for (let kv in split(qp, '&')) {
					let i = index(kv, '=');
					if (i > 0)
						p[substr(kv, 0, i)] = substr(kv, i + 1);
				}

				let url = 'http://' + portal_ip + '/quickauthdisconn.do';
				// no --header here either: uclient-fetch rejects it (see
				// fetch() above) and the logout would silently fail
				//
				// portaltype: the stock logout page sends getParam('portaltype')
				// which is ABSENT from the logout.html URL - i.e. an EMPTY
				// string. v2.7.3 and earlier hard-coded '0' here and the AC
				// answered code=1 (下线失败); mirror the stock client exactly.
				let cmd = 'uclient-fetch -q -T 8 --user-agent ' + q + UA + q +
					' --post-data=' + q +
					'wlanacip=' + (p.wlanacip ?? '10.1.110.3') +
					'&wlanuserip=' + (p.wlanuserip ?? '') +
					'&wlanacname=' + (p.wlanacname ?? '') +
					'&version=0&portaltype=&userid=' + userid +
					'&mac=' + (p.mac ?? '') + '&groupId=' + (args?.groupId ?? '2') +
					q + ' -O - ' + q + url + q + ' 2>/dev/null';
				let exec = popen(cmd);
				let out = exec.read('all');
				exec.close();
				return { code: jget(out, 'code'), message: jget(out, 'message') };
			}
		}
	}
};
UCEOF

# --- 5) ACL --------------------------------------------------------------
mkdir -p /usr/share/rpcd/acl.d
cat > /usr/share/rpcd/acl.d/campusauth.json <<'JSONEOF'
{
	"campusauth": {
		"description": "Campus portal auth page backend",
		"read": {
			"ubus": {
