# --- 7) LuCI view (JS) ----------------------------------------------------
mkdir -p /www/luci-static/resources/view
cat > /www/luci-static/resources/view/campusauth.js <<'JSEOF'
'use strict';
'require view';
'require ui';
'require rpc';
'require form';

var callStatus = rpc.declare({
	object: 'campusauth',
	method: 'status',
	expect: {}
});

var callLogin = rpc.declare({
	object: 'campusauth',
	method: 'login',
	expect: {}
});

var callLogout = rpc.declare({
	object: 'campusauth',
	method: 'logout',
	expect: {}
});

return view.extend({
	load: function() {
		return L.resolveDefault(callStatus(), {});
	},

	render: function(st) {
		var m, s, o;

		m = new form.Map('campusauth', _('校园网认证'),
			_('校园网 Portal 自动认证（抓包逆向实现）。保存凭据并启用后，后台服务会自动登录并掉线重连。') +
			_('<br /><br />当前状态：<code>%s</code>（后台服务：%s）')
				.format(st.status || '未知',
					(st.running === true) ? _('运行中') : _('未运行')));

		s = m.section(form.NamedSection, 'login', 'login', _('认证设置'));

		o = s.option(form.Flag, 'enabled', _('启用自动认证'));
		o.rmempty = false;

		o = s.option(form.Value, 'username', _('学号'));
		o.rmempty = false;
		o.datatype = 'string';
		o.password = true;

		o = s.option(form.Value, 'password', _('密码'));
		o.password = true;
		o.rmempty = false;

		o = s.option(form.Value, 'interval', _('检测间隔（秒）'),
			_('每间隔多少秒检查一次在线状态，掉线后自动重新认证。'));
		o.rmempty = false;
		o.datatype = 'range(30, 3600)';
		o.placeholder = '90';

		s = m.section(form.NamedSection, 'portal', 'portal', _('Portal 服务器'));

		o = s.option(form.Value, 'portal_ip', _('Portal 地址'),
			_('认证服务器 IP，一般无需修改。'));
		o.rmempty = false;
		o.datatype = 'ipaddr';
		o.placeholder = '10.1.110.2';

		o = s.option(form.Button, '_login', _('立即认证'));
		o.inputstyle = 'apply';
		o.inputtitle = _('登录');
		o.onclick = function(ev) {
			return callLogin().then(function(ret) {
				if (ret && (ret.code == '0' || ret.code == 0)) {
					ui.addNotification(null, _('认证成功，已上线。'), 'info');
				}
				else if (ret && (ret.code == '201')) {
					ui.addNotification(null, _('已在线，无需重复认证。'), 'info');
				}
				else if (ret && ret.error) {
					ui.addNotification(null, _('认证失败：%s').format(ret.error), 'error');
				}
				else {
					ui.addNotification(null, _('认证失败（code=%s）：可能是学号密码错误或需要设备绑定。').format(ret ? ret.code : '?'), 'error');
				}
			});
		};

		o = s.option(form.Button, '_logout', _('手动下线'));
		o.inputstyle = 'reset';
		o.inputtitle = _('下线');
		o.onclick = function(ev) {
			return callLogout().then(function(ret) {
				if (ret && (ret.code == '0' || ret.code == 0)) {
					ui.addNotification(null, _('已下线。'), 'info');
				}
				else {
					ui.addNotification(null, _('下线失败（code=%s）').format(ret ? ret.code : '?'), 'error');
				}
			});
		};

		return m.render();
	}
});
JSEOF

# enable the service on boot: start_service() no-ops while
# campusauth.login.enabled != 1, so enabling the init script up front is
# safe - the daemon springs to life as soon as the user ticks the checkbox.
/etc/init.d/campus-auth enable

# Also run "start" ONCE here: boot(START=10) runs uci-defaults long before
# S99campus-auth, and until the init's first procd "start" the service
# entry (with its procd_add_reload_trigger) is NOT registered with procd.
# Without this, the very first "保存并应用" after flashing would commit
# campusauth but nothing would start the daemon. With an empty instance
# (enabled=0) this start is a no-op besides registering entry + triggers.
/etc/init.d/campus-auth start 2>/dev/null

# ucitrack: LuCI "保存并应用" on the campusauth config reloads the daemon
# (writes /usr/share/ucitrack/campusauth.json; ucitrack initscript picks it
# up on next boot, and LuCI's apply loop reloads the init right away).
mkdir -p /usr/share/ucitrack
cat > /usr/share/ucitrack/campusauth.json <<'UTEOF'
{
	"config": "campusauth",
	"init": "campus-auth"
}
UTEOF

rm -f /tmp/luci-indexcache* /tmp/luci-modulecache/* 2>/dev/null

exit 0
