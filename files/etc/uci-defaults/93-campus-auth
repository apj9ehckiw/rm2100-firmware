# --- 7) LuCI view (JS) ----------------------------------------------------
mkdir -p /www/luci-static/resources/view
cat > /www/luci-static/resources/view/campusauth.js <<'JSEOF'
'use strict';
'require view';
'require ui';
'require rpc';
'require form';

var callStatus = rpc.declare({
	object: 'campusauth',
	method: 'status',
	expect: {}
});

var callLogin = rpc.declare({
	object: 'campusauth',
	method: 'login',
	expect: {}
});

var callLogout = rpc.declare({
	object: 'campusauth',
	method: 'logout',
	expect: {}
});

// HH:MM validation. NOTE: LuCI 24.10 has no 'time' datatype (only
// 'timehhmmss'); an unknown datatype name makes Validator.compile throw
// SyntaxError and kills the whole form, so validate via o.validate.
// Signature is validate(section_id, value) - the framework binds the
// section id as the FIRST argument (getValidator does
// L.bind(this.validate, this, section_id) and validation.js then calls
// vfunc(value)), so a single-parameter f(value) receives the section id
// ('login') instead of the input and rejects every well-formed time.
function validateHHMM(section_id, value) {
	if (value == null || value == '')
		return true;
	if (!/^(2[0-3]|[01][0-9]):[0-5][0-9]$/.test(value))
		return _('格式须为 HH:MM，如 07:00 或 23:30');
	return true;
}

return view.extend({
	load: function() {
		return L.resolveDefault(callStatus(), {});
	},

	// Map the daemon status prefix to a human line. The daemon writes
	// "<state>（detail） <timestamp>" into /tmp/campus-auth.status; showing
	// the raw string is accurate but opaque, so translate the leading token
	// and keep the detail + timestamp visible.
	statusLine: function(st) {
		var raw = st.status || '未知';
		var m = raw.match(/^([a-z-]+)[（(]?(.*)$/);
		var head = m ? m[1] : raw;
		var detail = raw;

		var labels = {
			'online': _('在线'),
			'online(already)': _('在线（此前已认证）'),
			'online(no-hijack)': _('在线（无劫持）'),
			'online(mac-auth/免认证)': _('在线（免认证）'),
			'online(稳态)': _('在线'),
			'banned': _('已被封禁'),
			'ban-expired': _('封禁已到期'),
			'maintenance': _('停机时段'),
			'off-campus': _('非校园网络'),
			'paused': _('已暂停'),
			'disabled': _('未启用'),
			'disconnected': _('已断开'),
			'no-credentials': _('缺少凭据'),
			'no-portal-response': _('Portal 无响应'),
			'portal-transition': _('Portal 过渡态'),
			'probe-failed': _('探测异常'),
			'offline': _('离线'),
			'bind-required': _('需设备绑定'),
			'failed': _('认证失败'),
			'unknown': _('未知状态')
		};
		var label = labels[head];
		if (!label) {
			// statuses like 'online(...)' variants not in the table
			var m2 = head.match(/^(online\([^)]*\))/);
			label = m2 ? _('在线') : null;
		}
		return {
			label: label || head,
			detail: detail,
			isBanned: (head === 'banned'),
			isOnline: (head.indexOf('online') === 0)
		};
	},

	render: function(st) {
		var m, s, o;

		var stat = this.statusLine(st);
		var color = stat.isBanned ? '#e03131' : (stat.isOnline ? '#2f9e44' : '#5c7cfa');
		var weight = (stat.isBanned || stat.isOnline) ? 'font-weight:700;' : '';

		m = new form.Map('campusauth', _('校园网认证'),
			_('校园网 Portal 自动认证（抓包逆向实现）。保存凭据并启用后，后台服务会自动登录并掉线重连。') +
			_('<br /><br />当前状态：<span style="color:%s;%s">%s</span>（后台服务：%s）<br /><code style="font-size:0.85em">%s</code>')
				.format(color, weight, stat.label,
					(st.running === true) ? _('运行中') : _('未运行'),
					stat.detail) +
			(stat.isBanned
				? _('<br /><b style="color:#e03131">注意：触发代理行为检测已被封禁。封禁期间同 MAC 重复尝试认证会加重标记，守护进程已静默等待，请勿手动点击「登录」。到期后自动恢复。</b>')
				: ''));

		s = m.section(form.NamedSection, 'login', 'login', _('认证设置'));

		o = s.option(form.Flag, 'enabled', _('启用自动认证'));
		o.rmempty = false;

		o = s.option(form.Value, 'username', _('学号'));
		o.rmempty = false;
		o.datatype = 'string';
		o.password = true;

		o = s.option(form.Value, 'password', _('密码'));
		o.password = true;
		o.rmempty = false;

		o = s.option(form.Value, 'interval', _('检测间隔（秒）'),
			_('每间隔多少秒检查一次在线状态，掉线后自动重新认证。'));
		o.rmempty = false;
		o.datatype = 'range(30, 3600)';
		o.placeholder = '90';

		o = s.option(form.Value, 'active_start', _('运行开始时间'),
			_('自动认证的每日运行起始时间（HH:MM，如 07:00）。留空 = 全天运行。'));
		o.rmempty = true;
		o.placeholder = '07:00';
		o.validate = validateHHMM;

		o = s.option(form.Value, 'active_end', _('运行结束时间'),
			_('自动认证的每日运行结束时间（HH:MM，如 23:30）。开始晚于结束时视为跨午夜时段（如 22:00-06:00）。留空 = 全天运行。'));
		o.rmempty = true;
		o.placeholder = '23:30';
		o.validate = validateHHMM;

		s = m.section(form.NamedSection, 'login', 'login', _('运行星期'));
		s.description = _('自动认证在一周中的哪几天运行。跨午夜时段（如 22:00-06:00）在 00:00 后属于新的一天。') + '<br />' +
			_('提示：全部取消勾选等同于每天运行；如果哪天都不想运行，直接关闭上方的「启用自动认证」即可。');

		var weekdays = [
			[ 'day_1', _('周一') ], [ 'day_2', _('周二') ], [ 'day_3', _('周三') ],
			[ 'day_4', _('周四') ], [ 'day_5', _('周五') ], [ 'day_6', _('周六') ],
			[ 'day_0', _('周日') ]
		];
		for (var i = 0; i < weekdays.length; i++) {
			o = s.option(form.Flag, weekdays[i][0], weekdays[i][1]);
			o.rmempty = false;
			o.default = '1';
		}

		s = m.section(form.NamedSection, 'portal', 'portal', _('Portal 服务器'));

		o = s.option(form.Value, 'portal_ip', _('Portal 地址'),
			_('认证服务器 IP，一般无需修改。'));
		o.rmempty = false;
		o.datatype = 'ipaddr';
		o.placeholder = '10.1.110.2';

		o = s.option(form.Button, '_login', _('立即认证'));
		o.inputstyle = 'apply';
		o.inputtitle = _('登录');
		o.onclick = function(ev) {
			return callLogin().then(function(ret) {
				if (ret && (ret.code == '0' || ret.code == 0)) {
					ui.addNotification(null, _('认证成功，已上线。'), 'info');
				}
				else if (ret && (ret.code == '201')) {
					ui.addNotification(null, _('已在线，无需重复认证。'), 'info');
				}
				else if (ret && ret.error) {
					ui.addNotification(null, _('认证失败：%s').format(ret.error), 'error');
				}
				else {
					ui.addNotification(null, _('认证失败（code=%s）：可能是学号密码错误或需要设备绑定。').format(ret ? ret.code : '?'), 'error');
				}
			});
		};

		o = s.option(form.Button, '_logout', _('手动下线'));
		o.inputstyle = 'reset';
		o.inputtitle = _('下线');
		o.onclick = function(ev) {
			return callLogout().then(function(ret) {
				if (ret && (ret.code == '0' || ret.code == 0)) {
					ui.addNotification(null, _('已下线。'), 'info');
				}
				else {
					// surface the portal's own message alongside the code:
					// "code=1" alone told us nothing while debugging the
					// portaltype mismatch (v2.7.4)
					var why = (ret && ret.message) ? _('：%s').format(ret.message) : '';
					ui.addNotification(null, _('下线失败（code=%s）%s').format(ret ? ret.code : '?', why), 'error');
				}
			});
		};

		return m.render();
	}
});
JSEOF

# enable the service on boot: start_service() no-ops while
# campusauth.login.enabled != 1, so enabling the init script up front is
# safe - the daemon springs to life as soon as the user ticks the checkbox.
/etc/init.d/campus-auth enable

# Also run "start" ONCE here: boot(START=10) runs uci-defaults long before
# S99campus-auth, and until the init's first procd "start" the service
# entry (with its procd_add_reload_trigger) is NOT registered with procd.
# Without this, the very first "保存并应用" after flashing would commit
# campusauth but nothing would start the daemon. With an empty instance
# (enabled=0) this start is a no-op besides registering entry + triggers.
/etc/init.d/campus-auth start 2>/dev/null

# ucitrack: LuCI "保存并应用" on the campusauth config reloads the daemon
# (writes /usr/share/ucitrack/campusauth.json; ucitrack initscript picks it
# up on next boot, and LuCI's apply loop reloads the init right away).
mkdir -p /usr/share/ucitrack
cat > /usr/share/ucitrack/campusauth.json <<'UTEOF'
{
	"config": "campusauth",
	"init": "campus-auth"
}
UTEOF

rm -f /tmp/luci-indexcache* /tmp/luci-modulecache/* 2>/dev/null

exit 0
