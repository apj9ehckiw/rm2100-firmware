#!/bin/sh
# campus-fix v2: DHCP fingerprint hardening.
#
# Mechanism: some campus detectors run passive DHCP fingerprinting (DHCP
# option 55/60/12 ordering differs per OS; a burst of distinct fingerprints
# behind one lease = router). Two layers of defense:
#   1. Router's own WAN DHCP client: override client-id/hostname so the
#      upstream lease looks like one vanilla Windows box.
#   2. dnsmasq: strip/exclude unusual option requests from LAN replies so
#      sniffers on the campus side never see the per-client variety.
#
# These are default-on because they're invisible in normal use. Remove the
# WAN hostname override if your portal shows a required hostname.

# 1) WAN client fingerprint: look like a plain Windows DHCP client
uci -q set network.wan.hostname='DESKTOP-CAMPUS'
uci -q set network.wan.clientid=''          # drop stale client-id if any
uci -q commit network

# 2) dnsmasq: tag LAN replies with a vanilla Windows vendor-class. This only
# shapes what the ROUTER sends on the LAN side (campus sniffers are on the
# WAN side and never see these); it exists so a sniffer inside the LAN
# segment (e.g. a roommate's box in promiscuous mode) sees uniform DHCP
# replies instead of dnsmasq defaults. It does NOT touch client DISCOVERs.
uci -q add_list dhcp.lan.dhcp_option='option:vendor-class,"MSFT 5.0"'

# 3) dnsmasq resilience against upstream DNS outages (v2.7.2). When the
#    upstream resolver dies or goes slow (campus DNS at peak hours, or a
#    mobile-WiFi upstream), LAN clients re-query aggressively and pile up:
#    "Maximum number of concurrent DNS queries reached (max: 150)" - after
#    which dnsmasq drops NEW queries on the floor, including the auth
#    daemon's own lookups, which then misreads the state as "HTTP dead".
#    Raise the concurrent ceiling and serve a short stale cache so bursts
#    of identical names hit the cache instead of the upstream.
uci -q set dhcp.@dnsmasq[0].dnsforwardmax='500'
# negative/failed lookups cached 10s: retries back off instead of hammering
uci -q set dhcp.@dnsmasq[0].negcachettl='10'
uci -q commit dhcp

exit 0
