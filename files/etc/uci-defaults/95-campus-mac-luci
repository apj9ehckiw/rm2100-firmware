#!/bin/sh
# campus-fix v2.3: WAN MAC management UI (ucode LuCI page).
#
# The firmware already randomizes the WAN MAC on first boot
# (97-campus-wan-hygiene, persisted in /etc/campus-fix-wanmac and applied
# via uci network.wan.macaddr). This adds a LuCI page to VIEW and SET it
# manually, so you can clone your PC's MAC or rotate on demand without ssh.
#
# Page: LuCI -> Network -> Campus MAC
# Implemented with the ucode-based LuCI runtime shipped in OpenWrt 24.10
# (luci-base has no Lua interpreter; Lua CBI pages require luci-compat,
# which is NOT installed). Uses menu.d JSON + rpcd ucode backend only.
#
# NOTE on random bytes: OpenWrt busybox has hexdump but NOT od.

# --- 1) rpcd plugin: expose live MAC read + random MAC generation
mkdir -p /usr/share/rpcd/ucode
cat > /usr/share/rpcd/ucode/campusmac <<'UCEOF'
// campus-fix rpcd backend: read live WAN MAC, generate random MAC
'use strict';

import { readfile, popen, pclose } from 'fs';
import { cursor } from 'uci';

const q = "'";

return {
	livemac: {
		call: function(request, args) {
			// resolve the wan logical interface to its device, then read MAC
			let uci = cursor();
			let dev = uci.get('network', 'wan', 'device');

			if (!dev) {
				// DSA 'wan' or legacy eth0.2: fall back to ifstatus
				let p = popen('ifstatus wan 2>/dev/null');
				let out = p.read('all');
				p.close();

				if (out) {
					let m = match(out, /"device":"([^"]+)"/);
					if (m)
						dev = m[1];
				}
			}

			if (!dev)
				return { mac: null, error: 'no wan device' };

			let mac = trim(readfile(`/sys/class/net/${dev}/address`) ?? '');

			return { mac: mac || null, device: dev };
		}
	},

	rotate: {
		call: function(request, args) {
			// hexdump (NOT od - od is not in the OpenWrt busybox applet set)
			let p = popen('hexdump -vn6 -e ' + q + '6/1 "%02x"' + q + ' /dev/urandom');
			let out = p.read('all');
			p.close();

			let hex = replace(out, /[^0-9a-f]/g, '');

			if (length(hex) < 12)
				return { mac: null, error: 'random source failed' };

			// first byte: locally-administered unicast (bit1 set, bit0 clear)
			let b1 = (hex2dec(substr(hex, 0, 2)) | 0x02) & 0xFE;

			return { mac: sprintf('%02x%s', b1, substr(hex, 2, 10)) };
		}
	}
};
UCEOF

# --- 2) ACL: allow the admin session to call the backend
mkdir -p /usr/share/rpcd/acl.d
cat > /usr/share/rpcd/acl.d/campusmac.json <<'JSONEOF'
{
	"campusmac": {
		"description": "Campus MAC page backend access",
		"read": {
			"ubus": {
				"campusmac": [ "livemac", "rotate" ]
			}
		},
		"write": {
			"ubus": {
				"campusmac": [ "livemac", "rotate" ]
			}
		}
	}
}
JSONEOF

# --- 3) menu entry (Network menu, after Firewall)
mkdir -p /usr/share/luci/menu.d
cat > /usr/share/luci/menu.d/campusmac.json <<'MENUEOF'
{
	"admin/network/campusmac": {
		"title": "Campus MAC",
		"order": 76,
		"action": {
			"type": "view",
			"path": "campusmac"
		},
		"depends": {
			"acl": [ "campusmac" ],
			"uci": { "network": true }
		}
	}
}
MENUEOF

# --- 4) client-side view (JS, native LuCI 24.10 pattern)
mkdir -p /www/luci-static/resources/view
cat > /www/luci-static/resources/view/campusmac.js <<'JSEOF'
'use strict';
'require view';
'require ui';
'require rpc';
'require form';

var callLivemac = rpc.declare({
	object: 'campusmac',
	method: 'livemac',
	expect: { 'mac': null, 'device': '' }
});

var callRotate = rpc.declare({
	object: 'campusmac',
	method: 'rotate',
	expect: { 'mac': null }
});

return view.extend({
	load: function() {
		return L.resolveDefault(callLivemac(), {});
	},

	render: function(live) {
		var m, s, o;

		m = new form.Map('network', _('Campus MAC'),
			_('The MAC address your router presents to the campus network. ') +
			_('A random locally-administered MAC was generated on first boot.') +
			_('<br /><br /><b>Format:</b> 6 hex pairs separated by colons, e.g. <code>12:34:56:78:9A:BC</code>. ') +
			_('Leave empty to go back to the router\'s factory WAN MAC.') +
			_('<br /><br /><b>Effective after</b> <code>ifup wan</code> or reboot. ') +
			_('Campus portals usually bind the auth session to the MAC - after changing it, re-login on the portal.'));

		s = m.section(form.NamedSection, 'wan', 'interface', _('WAN interface'));

		o = s.option(form.Value, 'macaddr', _('WAN MAC address'),
			_('Live MAC on the WAN device') + ': <code>' + (live ? (live.mac || _('unknown')) : _('unknown')) + '</code>');
		o.rmempty = true;
		o.datatype = 'macaddr';

		o = s.option(form.Button, '_rotate', _('Rotate (new random MAC)'));
		o.inputstyle = 'apply';
		o.inputtitle = _('Generate');
		o.onclick = function(ev) {
			return callRotate().then(function(ret) {
				if (ret && ret.mac) {
					var input = document.querySelector('.cbi-value-field input[id$="macaddr"]');
					if (input)
						input.value = ret.mac;
					ui.addNotification(null, _('New random MAC: <code>%s</code> - click "Save &amp; Apply" to persist.').format(ret.mac), 'info');
				}
				else {
					ui.addNotification(null, _('MAC generation failed'), 'error');
				}
			});
		};

		return m.render();
	}
});
JSEOF

# reload luci caches so the page appears without manual flush
rm -f /tmp/luci-indexcache* /tmp/luci-modulecache/* 2>/dev/null

exit 0
