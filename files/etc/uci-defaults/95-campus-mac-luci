#!/bin/sh
# campus-fix v2.6: WAN MAC management UI (ucode LuCI page).
#
# View and SET the WAN MAC manually - clone your PC's MAC or rotate on
# demand without ssh. The factory MAC is kept by default (no first-boot
# randomization since v2.6); a custom MAC set here is saved directly to
# uci (network.wan.macaddr) and re-applied by netifd on every ifup.
#
# Page: LuCI -> Network -> Campus MAC (校园网 MAC)
# Implemented with the ucode-based LuCI runtime shipped in OpenWrt 24.10
# (luci-base has no Lua interpreter; Lua CBI pages require luci-compat,
# which is NOT installed). Uses menu.d JSON + rpcd ucode backend only.
#
# NOTE on random bytes: OpenWrt busybox has hexdump but NOT od.
# NOTE: rpcd only scans /usr/share/rpcd/ucode at STARTUP - this script runs
# during first boot AFTER rpcd started, so we must restart rpcd for the
# plugin to register. Restarting rpcd during uci-defaults is safe (no LuCI
# sessions exist yet at that point).

# --- 1) rpcd plugin: expose live MAC read + random MAC generation
mkdir -p /usr/share/rpcd/ucode
cat > /usr/share/rpcd/ucode/campusmac <<'UCEOF'
// campus-fix rpcd backend: read live WAN MAC, generate random MAC
'use strict';

import { readfile, popen } from 'fs';
import { cursor } from 'uci';

const q = "'";

function wan_device() {
	let uci = cursor();
	let dev = uci.get('network', 'wan', 'device');

	// also consider an explicit macaddr override device section; ifstatus
	// gives the runtime truth (l3_device), use it as fallback
	if (!dev) {
		let p = popen('ifstatus wan 2>/dev/null');
		let out = p?.read('all');
		p?.close();

		let m = out ? match(out, /"l3_device"\s*:\s*"([^"]+)"/) : null;
		if (!m && out)
			m = match(out, /"device"\s*:\s*"([^"]+)"/);
		if (m)
			dev = m[1];
	}

	return dev;
}

// rpcd ucode plugins must return:
//   { <ubus-object-name>: { <method>: { call: fn, args: {...} }, ... } }
// (rpcd ucode.c rpc_ucode_script_validate: the top-level key IS the ubus
// object name; the official luci plugin does `return { luci: methods }`).
// We register the object `campusmac` with methods livemac/rotate.
return {
	campusmac: {
		livemac: {
			call: function(request, args) {
				let dev = wan_device();

				if (!dev)
					return { mac: null, error: 'no wan device' };

				let mac = trim(readfile(`/sys/class/net/${dev}/address`) ?? '');

				// fallback: the configured uci override (matches what will
				// apply on next ifup even if the device is down right now)
				if (!mac) {
					let uci = cursor();
					mac = uci.get('network', 'wan', 'macaddr') ?? '';
				}

				return { mac: mac || null, device: dev };
			}
		},

		rotate: {
			call: function(request, args) {
				// Random source chain, most-reliable first:
				//   1. /proc/sys/kernel/random/uuid - a procfs read, works
				//      with plain cat on every kernel (strip '-' and the
				//      version/variant nibbles, take 12 hex chars)
				//   2. hexdump /dev/urandom (the v2.6 approach - failed on
				//      some boxes: either popen() returned null and the
				//      unguarded p.read() threw (the rpcd method died ->
				//      LuCI showed "MAC 生成失败"), or the busybox hexdump
				//      -e format produced nothing)
				let hex = '';
				let u = readfile('/proc/sys/kernel/random/uuid');
				if (u) {
					hex = replace(replace(trim(u), '-', ''), /[^0-9a-f]/g, '');
					// skip the version nibble (uuid[12]) and variant nibble
					// (uuid[16]) so the entropy we keep is uniform-ish
					hex = substr(hex, 0, 12);
				}
				if (length(hex) < 12) {
					let p = popen('hexdump -vn6 -e ' + q + '6/1 "%02x"' + q + ' /dev/urandom');
					if (p) {
						let out = p.read('all');
						p.close();
						hex = replace(out ?? '', /[^0-9a-f]/g, '');
					}
				}

				if (length(hex) < 12)
					return { mac: null, error: 'random source failed' };

				// first byte: locally-administered unicast (bit1 set, bit0 clear)
				// (ucode builtin is hexdec - hex2dec does not exist)
				let b1 = (hexdec(substr(hex, 0, 2)) | 0x02) & 0xFE;

				return { mac: sprintf('%02x%s', b1, substr(hex, 2, 10)) };
			}
		}
	}
};
UCEOF

# --- 2) ACL: allow the admin session to call the backend
mkdir -p /usr/share/rpcd/acl.d
cat > /usr/share/rpcd/acl.d/campusmac.json <<'JSONEOF'
{
	"campusmac": {
		"description": "Campus MAC page backend access",
		"read": {
			"ubus": {
				"campusmac": [ "livemac", "rotate" ]
			}
		},
		"write": {
			"ubus": {
				"campusmac": [ "livemac", "rotate" ]
			}
		}
	}
}
JSONEOF

# --- 3) menu entry (Network menu, after Firewall)
mkdir -p /usr/share/luci/menu.d
cat > /usr/share/luci/menu.d/campusmac.json <<'MENUEOF'
{
	"admin/network/campusmac": {
		"title": "校园网 MAC",
		"order": 76,
		"action": {
			"type": "view",
			"path": "campusmac"
		},
		"depends": {
			"acl": [ "campusmac" ],
			"uci": { "network": true }
		}
	}
}
MENUEOF

# --- 4) client-side view (JS, native LuCI 24.10 pattern)
mkdir -p /www/luci-static/resources/view
cat > /www/luci-static/resources/view/campusmac.js <<'JSEOF'
'use strict';
'require view';
'require ui';
'require rpc';
'require form';

var callLivemac = rpc.declare({
	object: 'campusmac',
	method: 'livemac',
	// NOTE: rpc.js replaces the reply value with the expect default whenever
	// the types mismatch - a null default would overwrite a real string MAC
	// with null. Keep the default's TYPE identical to the real value type.
	expect: { 'mac': '' }
});

var callRotate = rpc.declare({
	object: 'campusmac',
	method: 'rotate',
	expect: { 'mac': '' }
});

return view.extend({
	load: function() {
		return L.resolveDefault(callLivemac(), {});
	},

	render: function(live) {
		var m, s, o;

		m = new form.Map('network', _('校园网 MAC'),
			_('路由器在校园网侧呈现的 MAC 地址。默认使用出厂 MAC；也可克隆电脑网卡 MAC 或按需换新。') +
			_('<br /><br /><b>格式：</b>6 组冒号分隔的十六进制，如 <code>12:34:56:78:9A:BC</code>。') +
			_('留空保存即可恢复出厂 WAN MAC。') +
			_('<br /><br /><b>生效方式：</b><code>ifup wan</code> 或重启。') +
			_('校园网认证通常与 MAC 绑定——修改后需在认证页重新登录。'));

		s = m.section(form.NamedSection, 'wan', 'interface', _('WAN 接口'));

		o = s.option(form.Value, 'macaddr', _('WAN MAC 地址'),
			_('WAN 口当前实际 MAC') + ': <code>' + ((live && live.mac) ? live.mac : _('未知')) + '</code>');
		o.rmempty = true;
		o.datatype = 'macaddr';

		o = s.option(form.Button, '_rotate', _('换新随机 MAC'));
		o.inputstyle = 'apply';
		o.inputtitle = _('生成');
		o.onclick = function(ev) {
			return callRotate().then(function(ret) {
				if (ret && ret.mac) {
					var input = document.querySelector('.cbi-value-field input[id$="macaddr"]');
					if (input)
						input.value = ret.mac;
					ui.addNotification(null, _('新随机 MAC：<code>%s</code>——点击「保存并应用」生效。').format(ret.mac), 'info');
				}
				else {
					ui.addNotification(null, _('MAC 生成失败'), 'error');
				}
			});
		};

		return m.render();
	}
});
JSEOF

# reload luci caches so the page appears without manual flush
rm -f /tmp/luci-indexcache* /tmp/luci-modulecache/* 2>/dev/null

# rpcd scans /usr/share/rpcd/ucode/ only at startup. During FIRST BOOT this
# script runs inside boot's uci_apply_defaults, BEFORE S12rpcd starts - so
# rpcd will pick the plugins up naturally and no restart is needed (restarting
# here would merely start rpcd prematurely). Only when this script is re-run
# on an ALREADY-booted system (rpcd running) do we restart it to register the
# freshly written plugins.
if pgrep -x rpcd >/dev/null 2>&1; then
	/etc/init.d/rpcd restart 2>/dev/null || killall -HUP rpcd 2>/dev/null
fi

exit 0
