#!/bin/sh
# campus-fix v2.7.1: fw4 health self-check on first boot.
#
# Background (v2.7.0 postmortem): a drop-in under /etc/nftables.d/ that fails
# to load on the TARGET kernel makes fw4 abort loading the whole inet fw4
# table. fw4's nftables.d include is atomic - one bad rule and the entire
# table is gone. v2.7.0 shipped a ruleset that CI (nft -c, userspace 1.0.9)
# accepted but the router still ended up with a dead LAN (breed reflash of
# kernel1+rootfs0 did not help, so the failure was somewhere in first-boot
# service bring-up, not in flash wear). Whatever the exact culprit turns out
# to be, the router must NEVER lose its LAN over a filter rule again.
#
# Mechanism: run LATE in uci-defaults (number 89, after all other scripts
# have written their files but the firewall has not necessarily started
# yet - fw4 starts at S19, uci-defaults at S10, so at this point we cannot
# test the real load. Instead we arm a boot-time check).
#
# The real check runs as an init script ordered BEFORE fw4 (START=18):
#   - if /etc/nftables.d/*.nft exists, try `fw4 restart`
#   - if it fails, move ALL drop-ins to /etc/nftables.d.disabled/ and
#     `fw4 restart` again - this second attempt must succeed (stock fw4
#     without drop-ins is the upstream default and always loads)
#   - log loudly either way (logread -e campus-fw4guard)
#
# Result: worst case (a broken drop-in) the router comes up with the stock
# firewall + NAT - internet works, LuCI works, only the campus anti-
# detection extras are off. The failure is visible in the log instead of
# being a dead LAN.
#
# v2.9.1: the init script is armed too late for FIRST boot. uci-defaults
# runs at S10; an enable at S10 creates the S18 rc.d symlink AFTER this
# boot's start sequence was already expanded, so the guard only ever ran
# from the SECOND boot on - leaving the riskiest boot (first flash, exactly
# when v2.7.0 died) unguarded. Fix: run the same dry-run check INLINE here
# at S10, before fw4's S19 loads the ruleset. Quarantine-at-S10 wins the
# race cleanly: fw4 then starts with either the validated drop-ins or the
# stock ruleset.
#
# v2.9.2: THE S18 GUARD NEVER RAN AT ALL. The generated init script defined
# only start_service() with no USE_PROCD=1, and /etc/rc.common ships a
# default `start() { return 0 }` (line 11) that is only OVERRIDDEN inside
# the `[ -n "$USE_PROCD" ] && {...}` block (line 121). So `S18campus-fw4guard
# boot` -> boot() -> start() -> return 0: start_service() was dead code on
# every boot. Combined with /etc/init.d/boot's `( . "$file" ) && rm -f
# "$file"` deleting this uci-defaults script after first boot, the ONLY
# working protection was the v2.9.1 inline check - i.e. the safety net
# existed for exactly one boot ever. Fix: define start() directly (the
# idiom every non-procd OpenWrt init uses - sysfixtime/sysctl/led/umount),
# which also sidesteps procd's empty-instance path entirely.

mkdir -p /etc/init.d
cat > /etc/init.d/campus-fw4guard <<'GUARDEOF'
#!/bin/sh /etc/rc.common
# campus-fix v2.7.1: quarantine broken nftables.d drop-ins before fw4 loads.
# fw4 includes /etc/nftables.d/*.nft atomically - one rule the kernel
# rejects and the whole fw4 table fails to load. This guard tries a dry-run
# load first; on failure it moves every drop-in aside and leaves fw4 with
# the stock ruleset so the LAN always comes up.
START=18

# NOT USE_PROCD: this is a one-shot boot task with no supervised instance.
# It must be `start()` - rc.common's default `start() { return 0 }` is only
# replaced when USE_PROCD=1 is set, so a bare start_service() here would be
# silently skipped (that was the v2.7.1~v2.9.1 bug: the guard never ran).
start() {
	# no drop-ins -> nothing to guard
	ls /etc/nftables.d/*.nft >/dev/null 2>&1 || return 0

	# Dry-run the full ruleset fw4 would load. `fw4 print` emits the
	# complete nft file (including the /etc/nftables.d/*.nft drop-ins);
	# feed it to `nft -c -f -` for a syntax+semantic check without touching
	# the running ruleset. -c still consults the kernel for some
	# expressions, which is exactly what we want (the v2.7.0 failure mode
	# was userspace-OK-kernel-NO, which plain `nft -c` in CI could not see).
	# Pipe exit status is nft's, and an EMPTY stdin is a valid (empty)
	# ruleset - so a `fw4 print` failure can never cause a false quarantine.
	if ! fw4 print 2>/dev/null | nft -c -f - >/dev/null 2>&1; then
		logger -t campus-fw4guard "fw4 ruleset FAILED dry-run; quarantining /etc/nftables.d drop-ins"
		mkdir -p /etc/nftables.d.disabled
		mv /etc/nftables.d/*.nft /etc/nftables.d.disabled/ 2>/dev/null
		logger -t campus-fw4guard "drop-ins moved to /etc/nftables.d.disabled - router runs stock firewall; check logread for the failing rule"
	else
		logger -t campus-fw4guard "fw4 ruleset dry-run OK"
	fi
	return 0
}
GUARDEOF
chmod +x /etc/init.d/campus-fw4guard

# fw4's own init is START=19 (S19firewall). Our guard must run first.
/etc/init.d/campus-fw4guard enable

# v2.9.1: ALSO run the check right here (S10, first boot). `enable` at S10
# creates the S18 rc.d symlink only for FUTURE boots - this boot's start
# sequence was already expanded - so without this the first boot's fw4 (S19)
# would load the drop-ins completely unguarded, and the first flash is
# exactly when v2.7.0 died.
#
# v2.9.2: call the init script we just wrote instead of duplicating the
# dry-run logic inline. Two copies of the same check is how the S18 path
# silently rotted into dead code in the first place; now the first-boot
# run and every later S18 run execute byte-identical code.
# `fw4 print` does not need fw4 to be running (it renders config, it does
# not query the live ruleset), and ubusd is up by S10, so this is safe here.
/etc/init.d/campus-fw4guard start
logger -t campus-fw4guard "first-boot inline guard done (uci-defaults S10)"

exit 0
